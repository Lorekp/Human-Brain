        "source": "use std::sync::mpsc;\nuse std::thread;\n\npub fn solve(values: &[i64]) -> Vec<i64> {\n    let (tx, rx) = mpsc::channel();\n    let owned = values.to_vec();\n    let worker = thread::spawn(move || {\n        for value in owned {\n            tx.send(value).unwrap();\n        }\n    });\n    let mut output: Vec<i64> = rx.into_iter().collect();\n    worker.join().unwrap();\n    output.sort();\n    output\n}\n",
